body
{
    margin: 0;
    padding: 0;
    font-family: "DejaVu Sans";
    font-size: 13px;
    color: #ffffff;
}

#overlay
{
    position: absolute;
    top: 20px;
    right: 20px;
    width: 330px;
    background-color: rgba(10, 24, 48, 0.85); /* Semi-transparent blue */
    border-width: 2px;
    border-style: solid;
    border-color: #1e3a8a; /* Glowing dark blue border */
    border-radius: 8px;
    padding: 12px 15px;
}

h1
{
    margin: 0 0 10px 0;
    font-size: 16px;
    font-weight: bold;
    color: #60a5fa; /* Light blue */
    text-align: center;
}

h2
{
    margin: 10px 0 4px 0;
    font-size: 12px;
    font-weight: bold;
    color: #93c5fd; /* Soft light blue */
    border-bottom-width: 1px;
    border-bottom-color: #1e3a8a;
    border-bottom-style: solid;
    padding-bottom: 2px;
}

.stat
{
    margin: 3px 0;
    display: inline-block;
    width: 100%;
}

.label
{
    color: #94a3b8; /* Cool gray */
    display: inline-block;
    width: 160px;
}

.value
{
    color: #34d399; /* Emerald green */
    font-weight: bold;
}

.value-blue
{
    color: #60a5fa; /* Blue */
    font-weight: bold;
}

.value-red
{
    color: #f87171; /* Soft red */
    font-weight: bold;
}

#combat-log
{
    height: 110px;
    background-color: rgba(15, 23, 42, 0.6);
    border-width: 1px;
    border-style: solid;
    border-color: #1e293b;
    padding: 4px;
    font-size: 10px;
    overflow-y: hidden;
}

.log-entry
{
    color: #cbd5e1;
    margin-bottom: 2px;
    white-space: nowrap;
}
