body
{
    margin: 0;
    padding: 0;
    font-family: "DejaVu Sans";
    font-size: 13dp;
    color: #ffffff;
}

#overlay
{
    position: absolute;
    top: 20dp;
    right: 20dp;
    width: 330dp;
    background-color: rgba(10, 24, 48, 0.85); /* Semi-transparent blue */
    border-width: 2dp;
    border-style: solid;
    border-color: #1e3a8a; /* Glowing dark blue border */
    border-radius: 8dp;
    padding: 12dp 15dp;
}

h1
{
    margin: 0 0 10dp 0;
    font-size: 16dp;
    font-weight: bold;
    color: #60a5fa; /* Light blue */
    text-align: center;
}

h2
{
    margin: 10dp 0 4dp 0;
    font-size: 12dp;
    font-weight: bold;
    color: #93c5fd; /* Soft light blue */
    border-bottom-width: 1dp;
    border-bottom-color: #1e3a8a;
    border-bottom-style: solid;
    padding-bottom: 2dp;
}

.stat
{
    margin: 3dp 0;
    display: inline-block;
    width: 100%;
}

.label
{
    color: #94a3b8; /* Cool gray */
    display: inline-block;
    width: 160dp;
}

.value
{
    color: #34d399; /* Emerald green */
    font-weight: bold;
}

.value-blue
{
    color: #60a5fa; /* Blue */
    font-weight: bold;
}

.value-red
{
    color: #f87171; /* Soft red */
    font-weight: bold;
}

#combat-log
{
    height: 110dp;
    background-color: rgba(15, 23, 42, 0.6);
    border-width: 1dp;
    border-style: solid;
    border-color: #1e293b;
    padding: 4dp;
    font-size: 10dp;
    overflow-y: hidden;
}

.log-entry
{
    color: #cbd5e1;
    margin-bottom: 2dp;
    white-space: nowrap;
}
