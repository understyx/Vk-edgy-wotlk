/* ElvUI style Unit Frame styles */
.unit-frame {
    position: absolute;
    width: 250dp;
    background-color: rgba(16, 16, 16, 0.95);
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d;
    border-radius: 0dp; /* Sharp corners */
    padding: 4dp;
}

/* Header integrated inside bar now, but fallback classes retained */
.unit-header {
    margin-bottom: 2dp;
    display: block;
    clear: both;
}

.unit-name {
    font-size: 12dp;
    font-weight: bold;
    color: #ffffff;
    float: left;
}

.unit-level {
    font-size: 11dp;
    font-weight: bold;
    color: #ffd100; /* WoW gold */
    float: right;
}

/* Bar styles */
.bar-container {
    height: 18dp;
    background-color: #111111; /* Dark backdrop representing empty bar */
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d;
    position: relative;
    border-radius: 0dp; /* Sharp corners */
    overflow: hidden;
    margin-bottom: 3dp;
    clear: both;
}

/* Specific heights for health vs power to mimic ElvUI */
.hp-container {
    height: 26dp;
}

.power-container {
    height: 11dp;
    margin-bottom: 0dp; /* No extra spacing below power bar */
}

.bar-fill {
    height: 100%;
}

/* Overlay Text Positions */
.bar-text-left {
    position: absolute;
    left: 6dp;
    top: 5dp;
    font-size: 11dp;
    font-weight: bold;
    color: #ffffff;
}

.bar-text-right {
    position: absolute;
    right: 6dp;
    top: 5dp;
    font-size: 11dp;
    font-weight: bold;
    color: #ffffff;
}

.power-text-left {
    position: absolute;
    left: 6dp;
    top: -1dp;
    font-size: 9dp;
    font-weight: bold;
    color: #ffffff;
}

.power-text-right {
    position: absolute;
    right: 6dp;
    top: -1dp;
    font-size: 9dp;
    font-weight: bold;
    color: #ffffff;
}

/* Health Bar Colors */
.hp-fill {
    background-color: #29a744; /* ElvUI vibrant green */
}

/* Power Bar Colors by Type */
.power-fill {
    background-color: #8552f6; /* Modern flat default purple */
}
.power-fill.pt-0 {
    background-color: #0076fe; /* Mana: Blue */
}
.power-fill.pt-1 {
    background-color: #df2c2c; /* Rage: Red */
}
.power-fill.pt-3 {
    background-color: #f5cb2b; /* Energy: Yellow */
}
.power-fill.pt-6 {
    background-color: #00bffe; /* Runic Power: Cyan */
}

/* Aura list */
.auras-container {
    margin-top: 5dp;
    clear: both;
}

.aura-title {
    font-size: 10dp;
    color: #a0a0a0;
    margin-bottom: 3dp;
    font-weight: bold;
    text-transform: uppercase;
}

.aura-badge {
    display: inline-block;
    background-color: #121212;
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d;
    border-radius: 0dp; /* Square aura badges */
    padding: 1dp 4dp;
    margin-right: 3dp;
    margin-bottom: 3dp;
    font-size: 9dp;
    color: #ffd100;
}
