<rml>
<head>
    <title>Party Frames</title>
    <link type="text/rcss" href="../overlay.rcss"/>
    <link type="text/rcss" href="../elements/bars.rcss"/>
    <style>
        body {
            position: absolute;
            left: 20dp;
            top: 150dp;
            width: 180dp;
            height: 400dp;
        }
        .party-container {
            display: flex;
            flex-direction: column;
            gap: 8dp;
        }
        .party-member {
            background-color: rgba(16, 16, 16, 0.95);
            border-width: 1dp;
            border-style: solid;
            border-color: #2d2d2d;
            border-radius: 0dp; /* Sharp corners */
            padding: 5dp;
            width: 150dp;
        }
        .party-member-dead {
            border-color: #801010;
            background-color: rgba(48, 12, 12, 0.95);
        }
        .member-out-of-range {
            opacity: 0.55;
        }
        .party-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3dp;
        }
        .party-name {
            font-size: 11dp;
            font-weight: bold;
            color: #ffffff;
            width: 105dp;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .party-dead-text {
            font-size: 10dp;
            font-weight: bold;
            color: #ff3333;
        }
        .party-bar {
            height: 14dp;
            background-color: #111111;
            border-width: 1dp;
            border-style: solid;
            border-color: #2c2c2c;
            position: relative;
            margin-bottom: 2dp;
            border-radius: 0dp; /* Sharp corners */
            overflow: hidden;
        }
        .party-hp-fill {
            height: 100%;
            background-color: #29a744; /* ElvUI vibrant green */
        }
        .party-hp-text {
            position: absolute;
            top: 0dp;
            width: 100%;
            text-align: center;
            font-size: 9dp;
            font-weight: bold;
            color: #ffffff;
        }
        .party-auras {
            display: flex;
            flex-wrap: wrap;
            gap: 2dp;
            margin-top: 3dp;
        }
        .party-aura {
            font-size: 8dp;
            background-color: #121212;
            border-width: 1dp;
            border-style: solid;
            border-color: #2d2d2d;
            border-radius: 0dp; /* Sharp corners */
            padding: 0dp 3dp;
            color: #ffd100;
        }
    </style>
</head>
<body data-model="wow">
    <!-- Show party frames only when logged in, in a party, and not in a raid -->
    <div class="party-container" data-show="playerIsIngame && numPartyMembers > 0 && numRaidMembers == 0">
        <div class="party-member" data-for="member : partyMembers" data-class-party-member-dead="member.health == 0">
            <div class="party-header">
                <span class="party-name">{{member.name}}</span>
                <span class="party-dead-text" data-show="member.health == 0">DEAD</span>
            </div>

            <div class="party-bar" data-hide="member.health == 0">
                <div class="party-hp-fill" style="width: {{ member.maxHealth > 0 ? (member.health * 100 / member.maxHealth) : 0 }}%;"></div>
                <div class="party-hp-text">{{member.health}} / {{member.maxHealth}}</div>
            </div>

            <!-- Member Auras -->
            <div class="party-auras" data-show="member.auras.size > 0">
                <span class="party-aura" data-for="spellId : member.auras">
                    {{spellId}}
                </span>
            </div>
        </div>
    </div>
</body>
</rml>
