body
{
    margin: 0;
    padding: 0;
    font-family: "DejaVu Sans";
    font-size: 16px;
    color: #ffffff;
}

#overlay
{
    position: absolute;
    top: 20px;
    left: 20px;
    width: 340px;
    background-color: rgba(10, 10, 25, 0.85);
    border-width: 2px;
    border-color: #00cc44;
    border-radius: 8px;
    padding: 14px 18px;
}

h1
{
    margin: 0 0 10px 0;
    font-size: 18px;
    color: #00cc44;
}

h2
{
    margin: 14px 0 6px 0;
    font-size: 14px;
    color: #00cc44;
    border-bottom-width: 1px;
    border-bottom-color: #333344;
    padding-bottom: 3px;
}

.stat
{
    margin: 5px 0;
    display: inline-block;
    width: 100%;
}

.label
{
    color: #aaaaaa;
    display: inline-block;
    width: 120px;
}

.value
{
    color: #00cc44;
    font-weight: bold;
}

.auras
{
    margin: 5px 0;
    display: inline-block;
    width: 100%;
}

.aura
{
    display: inline-block;
    background-color: #222244;
    border-width: 1px;
    border-color: #5555aa;
    border-radius: 4px;
    padding: 2px 6px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-size: 12px;
    color: #aaaaff;
}

#combat-log
{
    height: 120px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: #333333;
    padding: 4px;
    font-size: 11px;
    font-family: "DejaVu Sans";
}

.log-entry
{
    color: #dddddd;
    margin-bottom: 2px;
    white-space: nowrap;
}
