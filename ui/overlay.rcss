body
{
    margin: 0;
    padding: 0;
    font-family: "DejaVu Sans";
    font-size: 12dp;
    color: #ffffff;
}

#overlay
{
    position: absolute;
    top: 20dp;
    right: 20dp;
    width: 320dp;
    background-color: rgba(16, 16, 16, 0.92); /* Solid dark ElvUI background */
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d; /* Sharp ElvUI 1px border */
    border-radius: 0dp; /* 0 border-radius for classic sharp ElvUI look */
    padding: 10dp 12dp;
}

h1
{
    margin: 0 0 10dp 0;
    font-size: 14dp;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    background-color: #1a1a1a;
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d;
    border-radius: 0dp;
    padding: 5dp;
    text-transform: uppercase;
}

h2
{
    margin: 12dp 0 6dp 0;
    font-size: 11dp;
    font-weight: bold;
    color: #00bffe; /* Light blue/cyan theme */
    background-color: #1a1a1a;
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d;
    border-radius: 0dp;
    padding: 4dp 6dp;
    text-transform: uppercase;
}

.stat
{
    margin: 3dp 0;
    display: inline-block;
    width: 100%;
}

.label
{
    color: #a0a0a0; /* Clean medium gray */
    display: inline-block;
    width: 150dp;
    font-size: 11dp;
}

.value
{
    color: #2ebc54; /* ElvUI-like vibrant green */
    font-weight: bold;
    font-size: 11dp;
}

.value-blue
{
    color: #00bffe; /* Vibrant cyan */
    font-weight: bold;
    font-size: 11dp;
}

.value-red
{
    color: #f84b4b; /* Vibrant red */
    font-weight: bold;
    font-size: 11dp;
}

#combat-log
{
    height: 120dp;
    background-color: rgba(10, 10, 10, 0.95);
    border-width: 1dp;
    border-style: solid;
    border-color: #2d2d2d;
    border-radius: 0dp;
    padding: 6dp;
    font-size: 10dp;
    overflow-y: hidden;
}

.log-entry
{
    color: #dcdcdc;
    margin-bottom: 2dp;
    white-space: nowrap;
}
