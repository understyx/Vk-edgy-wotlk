<rml>
<head>
    <title>Player Unit Frame</title>
    <link type="text/rcss" href="../overlay.rcss"/>
    <link type="text/rcss" href="../elements/bars.rcss"/>
    <style>
        body {
            position: absolute;
            left: 220dp;
            bottom: 120dp;
            width: 250dp;
            height: 120dp;
        }
    </style>
</head>
<body data-model="wow">
    <div class="unit-frame" data-show="playerIsIngame">
        <!-- Health Bar with overlay text -->
        <div class="bar-container hp-container">
            <div class="bar-fill hp-fill" style="width: {{ playerMaxHealth > 0 ? (playerHealth * 100 / playerMaxHealth) : 0 }}%;"></div>
            <div class="bar-text-left">{{playerName}} <span style="color: #ffd100; font-size: 10dp;">Lv{{playerLevel}}</span></div>
            <div class="bar-text-right">{{playerHealth}} / {{playerMaxHealth}}</div>
        </div>

        <!-- Power Bar with overlay text -->
        <div class="bar-container power-container">
            <div class="bar-fill power-fill pt-{{playerPowerType}}" style="width: {{ playerMaxPower > 0 ? (playerPower * 100 / playerMaxPower) : 0 }}%;"></div>
            <div class="power-text-left">POWER</div>
            <div class="power-text-right">{{playerPower}} / {{playerMaxPower}}</div>
        </div>

        <!-- Auras below -->
        <div class="auras-container" data-show="playerAuras.size > 0">
            <div class="aura-title">Buffs & Debuffs</div>
            <span class="aura-badge" data-for="spellId : playerAuras">ID: {{spellId}}</span>
        </div>
    </div>
</body>
</rml>
