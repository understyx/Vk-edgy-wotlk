<rml>
<head>
    <title>Party Frames</title>
    <link type="text/rcss" href="../overlay.rcss"/>
    <link type="text/rcss" href="../elements/bars.rcss"/>
    <style>
        body {
            position: absolute;
            left: 20dp;
            top: 150dp;
            width: 180dp;
            height: 400dp;
        }
        .party-container {
            display: flex;
            flex-direction: column;
            gap: 10dp;
        }
        .party-member {
            background-color: rgba(10, 10, 12, 0.85);
            border-width: 1dp;
            border-style: solid;
            border-color: #3d3d3d;
            border-radius: 4dp;
            padding: 6dp;
            width: 150dp;
        }
        .party-member-dead {
            border-color: #991b1b;
            background-color: rgba(40, 10, 10, 0.85);
        }
        .party-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 4dp;
        }
        .party-name {
            font-size: 12dp;
            font-weight: bold;
            color: #ffffff;
            width: 100dp;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .party-dead-text {
            font-size: 11dp;
            font-weight: bold;
            color: #ef4444;
        }
        .party-bar {
            height: 12dp;
            background-color: #0d0d0d;
            border-width: 1dp;
            border-style: solid;
            border-color: #2a2a2a;
            position: relative;
            margin-bottom: 4dp;
            border-radius: 2dp;
            overflow: hidden;
        }
        .party-hp-fill {
            height: 100%;
            background-color: #228b22; /* Classic green */
        }
        .party-hp-text {
            position: absolute;
            top: 1dp;
            width: 100%;
            text-align: center;
            font-size: 9dp;
            font-weight: bold;
            color: #ffffff;
        }
        .party-auras {
            display: flex;
            flex-wrap: wrap;
            gap: 3dp;
            margin-top: 2dp;
        }
        .party-aura {
            font-size: 8dp;
            background-color: #1a1a24;
            border-width: 1dp;
            border-style: solid;
            border-color: #4a4a6a;
            border-radius: 2dp;
            padding: 0dp 3dp;
            color: #ffd100;
        }
    </style>
</head>
<body data-model="wow">
    <!-- Show party frames only when logged in, in a party, and not in a raid -->
    <div class="party-container" data-show="playerIsIngame && numPartyMembers > 0 && numRaidMembers == 0">
        <div class="party-member" data-for="member : partyMembers" data-class-party-member-dead="member.health == 0">
            <div class="party-header">
                <span class="party-name">{{member.name}}</span>
                <span class="party-dead-text" data-show="member.health == 0">DEAD</span>
            </div>

            <div class="party-bar" data-hide="member.health == 0">
                <div class="party-hp-fill" style="width: {{ member.maxHealth > 0 ? (member.health * 100 / member.maxHealth) : 0 }}%;"></div>
                <div class="party-hp-text">{{member.health}} / {{member.maxHealth}}</div>
            </div>

            <!-- Member Auras -->
            <div class="party-auras" data-show="member.auras.size > 0">
                <span class="party-aura" data-for="spellId : member.auras">
                    {{spellId}}
                </span>
            </div>
        </div>
    </div>
</body>
</rml>
