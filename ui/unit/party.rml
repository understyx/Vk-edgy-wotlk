<rml>
<head>
    <title>Party Frames</title>
    <link type="text/rcss" href="../overlay.rcss"/>
    <link type="text/rcss" href="../elements/bars.rcss"/>
    <style>
        body {
            position: absolute;
            left: 20px;
            top: 150px;
            width: 130px;
            height: 300px;
        }
        .party-member {
            background-color: rgba(10, 10, 12, 0.85);
            border-width: 1px;
            border-style: solid;
            border-color: #3d3d3d;
            border-radius: 4px;
            padding: 4px;
            margin-bottom: 6px;
            width: 110px;
        }
        .party-name {
            font-size: 11px;
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 2px;
        }
        .party-bar {
            height: 10px;
            background-color: #0d0d0d;
            border-width: 1px;
            border-style: solid;
            border-color: #2a2a2a;
            position: relative;
            margin-bottom: 2px;
        }
        .party-hp-fill {
            height: 100%;
            background-color: #228b22;
        }
        .party-mana-fill {
            height: 100%;
            background-color: #0000ff;
        }
    </style>
</head>
<body data-model="wow">
    <!-- Show party frames only when logged in -->
    <div data-show="playerIsIngame">
        <!-- Mock Party Member 1 -->
        <div class="party-member">
            <div class="party-name">Kaelthas</div>
            <div class="party-bar">
                <div class="party-hp-fill" style="width: 85%;"></div>
            </div>
            <div class="party-bar">
                <div class="party-mana-fill" style="width: 40%;"></div>
            </div>
        </div>

        <!-- Mock Party Member 2 -->
        <div class="party-member">
            <div class="party-name">Jaina</div>
            <div class="party-bar">
                <div class="party-hp-fill" style="width: 100%;"></div>
            </div>
            <div class="party-bar">
                <div class="party-mana-fill" style="width: 95%;"></div>
            </div>
        </div>

        <!-- Mock Party Member 3 -->
        <div class="party-member">
            <div class="party-name">Uther</div>
            <div class="party-bar">
                <div class="party-hp-fill" style="width: 60%;"></div>
            </div>
            <div class="party-bar">
                <div class="party-mana-fill" style="width: 15%;"></div>
            </div>
        </div>
    </div>
</body>
</rml>
