<rml>
<head>
    <title>Raid Frames</title>
    <link type="text/rcss" href="../overlay.rcss"/>
    <link type="text/rcss" href="../elements/bars.rcss"/>
    <style>
        body {
            position: absolute;
            left: 20dp;
            top: 150dp;
            width: 250dp;
            height: 400dp;
        }
        .raid-container {
            display: flex;
            flex-wrap: wrap;
            width: 240dp;
            gap: 4dp;
        }
        .raid-member {
            width: 55dp;
            height: 40dp;
            background-color: rgba(15, 15, 18, 0.88);
            border-width: 1dp;
            border-style: solid;
            border-color: #333333;
            border-radius: 2dp;
            position: relative;
            overflow: hidden;
        }
        .raid-member-dead {
            border-color: #991b1b;
            background-color: #4c0519;
        }
        .raid-member-out-of-range {
            opacity: 0.5;
        }
        .raid-hp {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: #228b22; /* Classic Green */
        }
        .raid-name {
            position: absolute;
            top: 4dp;
            width: 100%;
            text-align: center;
            font-size: 9dp;
            font-weight: bold;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .raid-status-text {
            position: absolute;
            bottom: 4dp;
            width: 100%;
            text-align: center;
            font-size: 8dp;
            font-weight: bold;
            color: #ef4444;
        }
    </style>
</head>
<body data-model="wow">
    <!-- Show raid frames only when logged in and in a raid -->
    <div class="raid-container" data-show="playerIsIngame && numRaidMembers > 0">
        <div class="raid-member" data-for="member : raidMembers" data-class-raid-member-dead="member.inRange && member.health == 0" data-class-raid-member-out-of-range="!member.inRange">
            <!-- Health Fill -->
            <div class="raid-hp" data-show="member.inRange" style="height: {{ member.maxHealth > 0 ? (member.health * 100 / member.maxHealth) : 0 }}%;"></div>

            <!-- Member Name -->
            <div class="raid-name">{{member.name}}</div>

            <!-- Dead Status Text -->
            <div class="raid-status-text" data-show="member.inRange && member.health == 0">DEAD</div>
        </div>
    </div>
</body>
</rml>